  clinic:{accent:'#087d82',paper:'#f1fbfb',ink:'#14383f',label:'CARE & WELLBEING',headline:'Your next step toward better care.',intro:'A clear, accessible design for service information, practice details and appointment enquiries.',services:['Care services','Practice information','Appointment enquiries'],cta:'Explore the care layout',shape:'+',layout:'care'},
  garage:{accent:'#dcef4c',paper:'#f1f2ed',ink:'#172425',label:'AUTOMOTIVE SERVICES',headline:'Keep your business moving.',intro:'A practical website concept that makes your services and enquiry options easy to find.',services:['Service information','Repair enquiries','Workshop details'],cta:'Explore the service layout',shape:'↗',layout:'industrial'},
  cleaning:{accent:'#167756',paper:'#f1f8ef',ink:'#17392c',label:'CLEANER SPACES',headline:'A fresh start for every space.',intro:'An approachable design for your service areas, packages and customer enquiries.',services:['Home cleaning','Business cleaning','Custom enquiries'],cta:'Explore the packages layout',shape:'✧',layout:'fresh'},
  shop:{accent:'#5046b5',paper:'#f5f2fb',ink:'#272344',label:'YOUR LOCAL BUSINESS',headline:'Make a great first impression online.',intro:'A thoughtful introduction to your business, products and the people you serve.',services:['Product highlights','Your business story','Visit or enquire'],cta:'Explore the collection layout',shape:'◇',layout:'retail'}
};
function design_(category){return DESIGNS[String(category)]||DESIGNS.shop;}
function demoSignature_(id,expires){const secret=props_().getProperty('DEMO_SECRET');if(!secret)throw Error('Run setup to initialize demo signing');return Utilities.base64EncodeWebSafe(Utilities.computeHmacSha256Signature(id+'|'+expires,secret)).replace(/=+$/,'');}
function demoLink_(r){
  const base=String(props_().getProperty('DEMO_BASE_URL')||'');
  if(!/^https:\/\/script\.google\.com\/macros\/s\/[A-Za-z0-9_-]+\/exec$/.test(base))return '';
  const expires=String(new Date(r.created_at||Date.now()).getTime()+30*86400000);
  if(!Number.isFinite(Number(expires))||Number(expires)<=Date.now())return '';
  return base+'?d='+encodeURIComponent(r.id)+'&e='+expires+'&s='+encodeURIComponent(demoSignature_(r.id,expires));
}
function equalSignature_(a,b){if(typeof a!=='string'||typeof b!=='string'||a.length!==b.length)return false;let diff=0;for(let i=0;i<a.length;i++)diff|=a.charCodeAt(i)^b.charCodeAt(i);return diff===0;}
function renderDemo_(r){
  const d=design_(r.category),e=escapeHtml_,name=e(r.business_name||'Your Business'),city=e(r.city||'Your city');
  const cards=d.services.map((x,i)=>'<article><span class="number">0'+(i+1)+'</span><h3>'+e(x)+'</h3><p>Suggested section — replace with the business owner’s confirmed offering.</p></article>').join('');
  return '<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><base target="_top"><title>'+name+' — proposed website design</title><style>'+ 
  ':root{--accent:'+d.accent+';--paper:'+d.paper+';--ink:'+d.ink+'}*{box-sizing:border-box}body{margin:0;color:var(--ink);background:var(--paper);font:16px/1.6 Arial,sans-serif}.notice{background:var(--ink);color:white;font-size:12px;text-align:center;padding:10px 18px}main,header,footer{max-width:1120px;margin:auto;padding:26px}header{display:flex;justify-content:space-between;align-items:center;gap:24px}.brand{font-size:22px;font-weight:800;letter-spacing:-1px}nav a{color:inherit;margin-left:20px;text-decoration:none;font-size:14px}.hero{display:grid;grid-template-columns:1.2fr 1fr;gap:48px;align-items:center;padding:54px 0 70px}.eyebrow{font-size:12px;letter-spacing:3px;font-weight:700}h1{font-family:Georgia,serif;font-size:clamp(40px,6vw,76px);line-height:1.04;letter-spacing:-2px;margin:20px 0}h2{font-family:Georgia,serif;font-size:36px;line-height:1.15}.intro{max-width:540px;color:var(--ink);opacity:.8}.cta{display:inline-block;background:var(--ink);color:white;padding:15px 23px;text-decoration:none;border-radius:6px;margin-top:18px}.art{height:380px;border-radius:48% 48% 10px 10px;background:var(--accent);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden}.symbol{font:220px Georgia;color:var(--paper);opacity:.85}.art small{position:absolute;bottom:20px;left:26px;color:var(--paper);letter-spacing:2px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}article{padding:26px;border:1px solid #0002;background:#ffffff55;border-radius:10px}.number{font-size:12px;font-weight:bold}.about{display:grid;grid-template-columns:1fr 1fr;gap:50px;padding:65px 0}.contact{border-top:1px solid #0002;padding:35px 0}.muted{font-size:13px;opacity:.75}footer{font-size:12px;border-top:1px solid #0002}.industrial .art{border-radius:4px;transform:rotate(-2deg)}.industrial h1{font-family:Arial,sans-serif;font-weight:900;text-transform:uppercase}.menu .grid{display:block}.menu article{display:flex;gap:26px;align-items:center;border-radius:0;border-width:0 0 1px}.care .art{border-radius:30px}.care h1{font-family:Arial,sans-serif;font-weight:500;letter-spacing:-3px}.fresh .art{border-radius:50% 15% 50% 15%}.retail .art{border-radius:6px;box-shadow:18px 18px 0 #0001}@media(max-width:680px){header,main,footer{padding:20px}nav{display:none}.hero{grid-template-columns:1fr;gap:25px;padding:30px 0}.art{height:250px}.grid,.about{grid-template-columns:1fr}.menu article{display:block}.about{gap:10px;padding:32px 0}h2{font-size:30px}}'+
  '</style></head><body class="'+d.layout+'"><div class="notice">PROPOSED DESIGN DEMO · Not the official '+name+' website · Content and services require owner approval</div><header><div class="brand">'+name+'</div><nav><a href="#services">Services</a><a href="#about">Our story</a><a href="#contact">Contact</a></nav></header><main><section class="hero"><div><div class="eyebrow">'+e(d.label)+' · '+city+'</div><h1>'+e(d.headline)+'</h1><p class="intro">'+e(d.intro)+'</p><a class="cta" href="#services">'+e(d.cta)+' ↗</a></div><div class="art" aria-label="Abstract design illustration"><span class="symbol" aria-hidden="true">'+d.shape+'</span><small>'+e(r.category||'business').toUpperCase()+' DESIGN CONCEPT</small></div></section><section id="services"><p class="eyebrow">DESIGNED AROUND YOUR BUSINESS</p><h2>A place for what you do best.</h2><div class="grid">'+cards+'</div></section><section class="about" id="about"><h2>A local business.<br>A memorable online presence.</h2><div><p>This is a proposed website for <strong>'+name+'</strong> in '+city+'. Your story, original photos and confirmed business information would go here.</p><p class="muted">No ratings, qualifications, prices, opening hours or customer testimonials have been invented.</p></div></section><section id="contact" class="contact"><p class="eyebrow">LET’S CONNECT</p><h2>Your customers’ next step, made simple.</h2><p>Space for your approved phone, location and contact button. This preview does not collect enquiries or bookings.</p><p class="muted">One-page website offer: '+e(price_(r))+'. Domain, paid hosting, ecommerce and custom integrations are separate.</p></section></main><footer><p>Independent proposal by '+e(props_().getProperty('SENDER_NAME')||'Vijay')+'. This is a design concept, not an endorsement or an operational business website.</p>'+(r.url&&/^https:\/\/(?:www\.)?google\.com\/maps\//.test(r.url)?'<p>Business listing source: <a href="'+e(r.url)+'" rel="noopener noreferrer">Google Maps</a></p>':'')+'</footer></body></html>';
}
function doGet(event){
  try{
    const p=event&&event.parameter||{};
    if(p.sample&&Object.prototype.hasOwnProperty.call(DESIGNS,p.sample))return HtmlService.createHtmlOutput(renderDemo_({business_name:'Sample '+p.sample.charAt(0).toUpperCase()+p.sample.slice(1),category:p.sample,city:'Your city',market:'International'})).addMetaTag('viewport','width=device-width,initial-scale=1');
    if(!p.d||!/^maps_[A-Za-z0-9-]+$/.test(p.d)||!/^\d{13}$/.test(p.e)||Number(p.e)<Date.now()||!equalSignature_(p.s,demoSignature_(p.d,p.e)))throw Error('Invalid link');
    const r=rows_().find(x=>x.id===p.d&&x.source_kind==='maps');if(!r)throw Error('Demo unavailable');
    return HtmlService.createHtmlOutput(renderDemo_(r)).addMetaTag('viewport','width=device-width,initial-scale=1');
  }catch(e){return HtmlService.createHtmlOutput('<p>This demo link is unavailable or expired.</p>');}
}
